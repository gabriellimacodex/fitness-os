{
  "name": "@fitness-os/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @fitness-os/schemas build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @fitness-os/schemas build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "pnpm --filter @fitness-os/schemas build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @fitness-os/schemas build",
    "test": "vitest run"
  },
  "dependencies": {
    "@fitness-os/schemas": "workspace:*",
    "fastify": "5.12.0"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  }
}
