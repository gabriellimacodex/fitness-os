{
  "name": "@fitness-os/database",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema boundary and Drizzle Kit configuration for Fitness OS.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --no-file-parallelism",
    "test:integration": "vitest run --no-file-parallelism test/*.integration.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@fitness-os/domain": "workspace:*",
    "@fitness-os/schemas": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
