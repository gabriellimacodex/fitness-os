{
  "name": "@fitness-os/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared compile-time configuration artifacts for Fitness OS packages.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
